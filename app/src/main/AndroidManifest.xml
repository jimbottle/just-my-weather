<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather data comes over the network from the NWS API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Coarse location is enough to resolve an NWS grid point; we never
         ask for fine location. The permission is optional and requested on
         demand — without it the app falls back to a default place
         (picking/saving your own place is planned). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Personal alerts post local notifications (Android 13+ opt-in). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional weather hand-off to Gadgetbridge, which relays to a paired
         watch. From targetSdk 30 a package not named here is invisible to
         PackageManager: getPackageInfo throws NameNotFoundException as though
         Gadgetbridge were absent, so detection would report "not installed" on
         a phone that has it. No permission is involved — visibility only.
         Keep in sync with GadgetbridgeBroadcaster.KNOWN_PACKAGES. -->
    <queries>
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly" />
        <package android:name="com.espruino.gadgetbridge.banglejs" />
    </queries>

    <application
        android:name=".JustMyWeatherApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustMyWeather">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.JustMyWeather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
