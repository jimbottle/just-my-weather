<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's live preview on Android 12+: the shipped default,
     a temperature tile. Plain views, because the picker inflates it in the
     launcher's process — nothing here reaches the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_label"
        android:textColor="#5B5F66"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="@string/widget_preview_value"
        android:textColor="#1A1C1E"
        android:textSize="40sp" />
</LinearLayout>
