<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy launcher icon for API 24-25, which can't render the adaptive icon in
  mipmap-anydpi-v26. Same sun-on-dark-field, composed as a plain layer-list so
  it resolves as an ordinary drawable on pre-26 devices. API 26+ prefers the
  adaptive icon (the more specific -v26 qualifier wins).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
